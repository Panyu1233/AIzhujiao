# ===== 必填 =====
# FastGPT 请求时携带的 Bearer Token（生产环境务必设置为高强度随机字符串）
FASTGPT_FILE_LIBRARY_TOKEN=change-me-to-a-long-random-token

# ===== 运行环境 =====
# 生产环境固定为 PROD；本地开发不要设置或设为 DEV
# APP_ENV=PROD
# 服务监听地址与端口（阿里云 ECS / 容器 / 反向代理统一使用）
# HOST=0.0.0.0
# PORT=5000

# ===== 知识库挂载 =====
# 知识库根目录的绝对路径；不配置时默认使用项目内 ./knowledge-base
# KNOWLEDGE_BASE_ROOT=/data/knowledge-base
# 用户信息、聊天记录等暂存/正式库中间文件目录；默认 <KNOWLEDGE_BASE_ROOT>/local-data
# LOCAL_DATA_ROOT=/data/knowledge-base/local-data

# ===== 对外地址 =====
# 阿里云自定义域名或负载均衡域名。必须在部署面板配置，用于拼接 previewUrl / readUrl / 火山回源地址。
# 例如：PUBLIC_BASE_URL=https://kb.example.com
# PUBLIC_BASE_URL=

# 本地开发允许的额外来源，逗号分隔；生产环境可留空
# ALLOWED_DEV_ORIGINS=localhost,127.0.0.1

# 文本文件直接内联返回 content 的体积上限（字节），超过则改用 previewUrl，默认 5MiB
# MAX_TEXT_BYTES=5242880

# 内存索引缓存时间（毫秒），默认 10000
# SCAN_CACHE_TTL_MS=10000

# 是否纳入点号开头的隐藏文件，默认 false
# INCLUDE_HIDDEN=false

# 额外忽略的文件/目录名，逗号分隔
# IGNORE_NAMES=.obsidian,.vscode,tmp

# 原始文件下载端点是否强制鉴权，默认 false（FastGPT 下载 previewUrl 不带鉴权头）
# REQUIRE_RAW_TOKEN=false

# ===== 火山知识库同步（KnowledgeBase / VikingDB）=====
# 火山知识库服务域名（尽量不带协议与末尾斜杠）
# VOLCANO_BASE_URL=api-knowledgebase.mlp.cn-beijing.volces.com
# 火山知识库 API Key（Bearer 鉴权）
# VOLCANO_API_KEY=your-viking-api-key
# 知识库名称（collection_name）
# VOLCANO_COLLECTION=DCAI
# 知识库所属项目
# VOLCANO_PROJECT=default
# 火山知识库服务 ID（新一代服务化凭据）
# VOLCANO_SERVICE_ID=kb-service-xxxxxxxxxxxxxxxx
# 文档处理策略（doc/v2/add 的 strategy 参数；不配置时默认 kb-strategy-49b76d085c9572f1）
# VOLCANO_STRATEGY=kb-strategy-49b76d085c9572f1
# 从私有 TOS 桶读取 tos_fe 原文件时使用（与 VIKING_API_KEY 不同，需要账号的 AK/SK）
# VOLCANO_TOS_ACCESS_KEY=
# VOLCANO_TOS_SECRET_KEY=
# VOLCANO_TOS_SECURITY_TOKEN=
# VOLCANO_TOS_REGION=cn-beijing
# VOLCANO_TOS_ENDPOINT=tos-cn-beijing.volces.com
# 可选；默认从 tos_path 的第一段自动识别桶名
# VOLCANO_TOS_BUCKET=

# ===== 模型 API（用户信息解析）=====
# 方舟托管模型优先；未配置方舟时回退官方 DeepSeek
# ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_MODEL=deepseek-v4-1-flash-261017
# DS_API_KEY=
# DS_BASE_URL=https://api.deepseek.com
# DS_MODEL=deepseek-chat

# ===== Supabase 多实例 =====
# 用户信息、手机号校准、聊天记录使用 Alzhujiao 官方 Supabase 实例。
# ALZHUJIAO_SUPABASE_URL=https://xxxx.supabase.co
# ALZHUJIAO_SUPABASE_KEY=sb_secret_xxxx
# ALZHUJIAO_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# 底层知识库文件持久化使用火山引擎 Supabase 兼容实例。
# VOLCES_SUPABASE_URL=https://xxxx.supabase2.aidap-global.cn-beijing.volces.com
# VOLCES_SUPABASE_KEY=sb_secret_xxxx

# 本项目专属表前缀；两个实例中的表统一使用该前缀，避免与其他项目冲突。
# SUPABASE_TABLE_PREFIX=ai_teacher_

# 兼容旧变量名；新部署不再推荐使用。
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# SHARE_SUPABASE_URL=
# SHARE_SUPABASE_KEY=
# SHARE_SUPABASE_SECRET_KEY=
# SHARE_TABLE_NAME=user_info

# ===== 外部数据源 =====
# 谷乐斯小程序全字段用户数据（服务端使用 X-API-Key）
# GULESI_BASE_URL=https://api.gulesi.com
# GULESI_API_KEY=your-gulesi-api-key

# 智能体聊天记录 API（用户提供后填写；页面只展示该数据源）
# AGENT_CHAT_API_URL=https://example.com/api/chat-records
# AGENT_CHAT_API_KEY=your-agent-api-key
# 默认 Authorization（自动补 Bearer 前缀）；如接口要求 X-API-Key 可改为该名称
# AGENT_CHAT_API_KEY_HEADER=Authorization

# 智能体用户信息 API（用户提供后填写）
# AGENT_USER_API_URL=https://example.com/api/users
# AGENT_USER_API_KEY=your-agent-user-api-key
# AGENT_USER_API_KEY_HEADER=Authorization

# ===== 后台管理口令 =====
# 后台 /api/admin/* 接入口令；缺省内置 kb-admin，生产环境务必覆盖为强口令。
# ADMIN_TOKEN=kb-admin
# 可选：覆盖后台登录账号/密码（不配置时仅用于本地预览的默认值）
# ADMIN_ACCOUNT=admin@aizhujiao
# ADMIN_PASSWORD=admin123
